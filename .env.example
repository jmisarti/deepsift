# Flask / Runtime
FLASK_SECRET_KEY=replace_with_long_random_secret
FLASK_DEBUG=0
SESSION_COOKIE_SECURE=1
PORT=5000
CRM_DB_PATH=./crm.db
RUN_BACKGROUND_WORKERS=1
# EXPOSE_API_ERRORS=0

# Optional App Login Gate (recommended for Railway deployment)
APP_AUTH_ENABLED=1
APP_AUTH_USERNAME=admin
# Use one of the next two:
APP_AUTH_PASSWORD=replace_with_strong_password
# APP_AUTH_PASSWORD_HASH=pbkdf2:sha256:...

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Gmail API OAuth (optional outbound email provider)
EMAIL_GMAIL_API_CLIENT_ID=
EMAIL_GMAIL_API_CLIENT_SECRET=
EMAIL_GMAIL_API_REFRESH_TOKEN=
EMAIL_GMAIL_WEBHOOK_TOKEN=

# SmrtPhone
SMRTPHONE_API_KEY=
SMRTPHONE_SEND_URL=https://phone.smrt.studio/sms/send
SMRTPHONE_FROM_NUMBER=19088679098
SMRTPHONE_WEBHOOK_BASE_URL=

# SkipSherpa
SKIPSHERPA_API_KEY=
SKIPSHERPA_BASE_URL=https://skipsherpa.com

# ReiSift
REISIFT_API_KEY=
REISIFT_EMAIL=
REISIFT_PASSWORD=
REISIFT_BASE_URL=https://apiv2.reisift.io
REISIFT_MAP_BASE_URL=https://map.reisift.io
REISIFT_REFERRAL_STATUS=refer_lead
REISIFT_FOLLOWUPS_EXCLUDE_TAG=3cf5a950-ac8f-47b0-87e1-bcea2604e2e1

# OpenLetterConnect (direct mail)
OPENLETTERCONNECT_API_KEY=
OPENLETTERCONNECT_BASE_URL=https://api.openletterconnect.com/api/v1
OPENLETTERCONNECT_TEMPLATE_ID=9256

# Google Sheets (Clever Leads polling automation)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_WORKSHEET_NAME=List of Customers
GOOGLE_SHEETS_POLL_SECONDS=300
GOOGLE_SERVICE_ACCOUNT_JSON=
